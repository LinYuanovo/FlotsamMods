{
  "schemaVersion": 1,
  "id": "flotsam.keyboardmove",
  "name": "键盘航行",
  "version": "3.0.0",
  "author": "临渊",
  "description": "不打开世界地图即可用键盘驾驶镇心（船）。按住 W/S 进退、A/D 转向，屏幕上的「航行仪表」实时显示航向、速度、本段航程、累计里程与电量可航距离；松开按键（或每航行一段距离）才像原版关闭地图那样提交一次世界坐标，因此周围的建筑不会再被反复重建而消失，转向也不再需要同时按前进。默认沿用游戏已有的镇心移动绑定，可在管理器（F10）改键。",
  "apiVersion": "1.1",
  "gameVersionRange": ">=1.0.0",
  "type": "code",
  "restartRequired": false,
  "entryAssembly": "FlotsamMod.KeyboardMove.dll",
  "entryType": "FlotsamMods.KeyboardMove.KeyboardMoveMod",
  "dependencies": [],
  "permissions": ["keybinds", "config", "ui"],
  "keybinds": [
    { "id": "move.forward",     "default": "W",      "display": "前进" },
    { "id": "move.backward",    "default": "S",      "display": "后退" },
    { "id": "move.rotateLeft",  "default": "A",      "display": "左转" },
    { "id": "move.rotateRight", "default": "D",      "display": "右转" },
    { "id": "move.settle",      "default": "Return", "display": "立即靠港（提交当前位置）" },
    { "id": "move.toggle",      "default": "F8",     "display": "启用/暂停键盘航行" }
  ]
}
